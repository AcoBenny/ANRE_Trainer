    },
    {
      "id": "CF-ELECTROTEHNICA-054",
      "record": "QABC-0047",
      "source": "V178_THIRD_15_EXACT_SOURCE_ABC_PEDAGOGICAL_CARDS_AC_HARMONICS_2026_11_20.json",
      "text": "Descărcătorul cu oxid de zinc limitează supratensiuni tranzitorii prin comportament neliniar al varistorului.",
      "disposition": ""
    },
    {
      "id": "CF-ELECTROTEHNICA-055",
