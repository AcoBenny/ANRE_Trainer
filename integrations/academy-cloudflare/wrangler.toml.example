name = "anre-academy-bridge"
main = "worker.mjs"
compatibility_date = "2026-11-20"

[vars]
PILOT_ENABLED = "false"
CF_GATEWAY_ID = "anre-academy"
CF_ACCOUNT_ID = "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"

[[kv_namespaces]]
binding = "ACADEMY_KV"
id = "REPLACE_WITH_ACTUAL_KV_NAMESPACE_ID"

# Use wrangler secret put GITHUB_WEBHOOK_SECRET
# Use wrangler secret put CF_API_TOKEN
# Use wrangler secret put REPORT_TOKEN
